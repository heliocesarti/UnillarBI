PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# URL do frontend publicado (Vercel), separadas por virgula se mais de uma.
# Vazio = sem restricao de CORS (uso local, frontend e backend no mesmo host).
CORS_ORIGINS=

# Chave usada pra assinar os tokens de login (JWT). Gere uma unica por
# ambiente com: python -c "import secrets; print(secrets.token_hex(32))"
# Nunca compartilhar nem versionar o valor real (so este .example fica vazio).
JWT_SECRET=

# Alerta automatico quando uma atualizacao (Ruptura/Indisponivel/Excesso) ou
# qualquer outro erro real do backend acontece. ALERT_CHANNEL = telegram | email | none (padrao)
ALERT_CHANNEL=none

# --- Se ALERT_CHANNEL=telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Se ALERT_CHANNEL=email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
